#!/usr/bin/env python3
"""Install pstack skills into coding-agent hosts."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import sys
from pathlib import Path

BEGIN = "<!-- BEGIN pstack-anywhere -->"
END = "<!-- END pstack-anywhere -->"
NOTICE_BEGIN = "<!-- BEGIN pstack-anywhere unavailable-capability notice -->"
NOTICE_END = "<!-- END pstack-anywhere unavailable-capability notice -->"
FORMATS = {"toml", "copilot", "markdown"}


def root() -> Path:
    return Path(__file__).resolve().parents[1]


def home() -> Path:
    return Path(os.environ.get("HOME", str(Path.home()))).expanduser()


def expand(value: str | None, project: Path | None = None) -> Path | None:
    if not value:
        return None
    codex_home = os.environ.get("CODEX_HOME", str(home() / ".codex"))
    return Path(value.replace("$HOME", str(home())).replace("$CODEX_HOME", codex_home).replace("$PROJECT", str(project or Path.cwd()))).expanduser()


def load_adapters() -> dict[str, dict]:
    result = {}
    for path in sorted((root() / "adapters").glob("*.json")):
        data = json.loads(path.read_text(encoding="utf-8"))
        result[data["name"]] = data
    return result


def skills() -> list[Path]:
    return sorted(path.parent for path in (root() / "skills").glob("*/SKILL.md"))


def frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    return dict(
        (line.split(":", 1)[0].strip(), line.split(":", 1)[1].strip().strip("\"'"))
        for line in text[3:end].splitlines()
        if ":" in line
    ) if end >= 0 else {}


def state_root() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", str(home() / ".local/state"))) / "pstack-anywhere"


def state_path(host: str, scope: str, project: Path | None) -> Path:
    identity = str(project or home()) if scope == "project" else str(home())
    digest = hashlib.sha256(identity.encode()).hexdigest()[:16]
    return state_root() / host / f"{scope}-{digest}.json"


def staging_root(host: str) -> Path:
    data = Path(os.environ.get("XDG_DATA_HOME", str(home() / ".local/share")))
    return data / "pstack-anywhere" / host / "skills"


def rewrite(text: str, adapter: dict, staged: Path) -> str:
    if adapter["name"] == "cursor":
        return text
    values = {
        "$PSTACK_SKILLS": str(staged),
        "$HOME": str(home()),
    }
    for old, new in adapter.get("rewrites", {}).items():
        if "pstack-anywhere-unavailable" in new:
            new = ("__PSTACK_UNAVAILABLE_TRANSCRIPTS__"
                   if "transcripts" in new else "__PSTACK_UNAVAILABLE_WORKTREES__")
        replacement = new
        for key, value in values.items():
            replacement = replacement.replace(key, value)
        if replacement.startswith("~"):
            replacement = str(home()) + replacement[1:]
        text = text.replace(old, replacement)
        if old.startswith("~"):
            text = text.replace("$HOME" + old[1:], replacement)
    return text


def unavailable_rewrites(adapter: dict) -> dict[str, str]:
    return {
        old: ("__PSTACK_UNAVAILABLE_TRANSCRIPTS__"
              if "transcripts" in new else "__PSTACK_UNAVAILABLE_WORKTREES__")
        for old, new in adapter.get("rewrites", {}).items()
        if "pstack-anywhere-unavailable" in new or new.startswith("__PSTACK_UNAVAILABLE_")
    }


def skill_needs_notice(source: Path, adapter: dict) -> bool:
    unavailable = unavailable_rewrites(adapter)
    if not unavailable:
        return False
    return any(
        any(old in path.read_text(encoding="utf-8") for old in unavailable)
        for path in source.rglob("*")
        if path.is_file()
    )


def unavailable_notice(adapter: dict) -> str:
    return (
        f"{NOTICE_BEGIN}\n\n"
        f"## unavailable on {adapter['display_name']}\n\n"
        "This skill depends on a host capability that is unavailable here, "
        "so it cannot run on this host. Say so clearly instead of looking for "
        "a substitute location or improvising findings.\n\n"
        f"{NOTICE_END}\n\n"
    )


def add_skill_notice(path: Path, adapter: dict, source: Path) -> None:
    if not skill_needs_notice(source, adapter):
        return
    skill_file = path / "SKILL.md"
    text = skill_file.read_text(encoding="utf-8")
    start, finish = text.find(NOTICE_BEGIN), text.find(NOTICE_END)
    if start >= 0 and finish >= start:
        finish += len(NOTICE_END)
        text = text[:start] + text[finish:].lstrip("\n")
    lines = []
    for line in text.splitlines(keepends=True):
        if "__PSTACK_UNAVAILABLE_" in line and not re.match(r"\s*[A-Za-z_][A-Za-z0-9_]*=", line):
            line = "Transcript history is unavailable on this host; do not look for a local transcript path.\n"
        lines.append(line)
    text = "".join(lines)
    notice = unavailable_notice(adapter)
    if text.startswith("---"):
        end = text.find("\n---", 3)
        if end >= 0:
            end += len("\n---")
            text = text[:end] + "\n\n" + notice + text[end:].lstrip("\n")
        else:
            text = notice + text
    else:
        text = notice + text
    skill_file.write_text(text, encoding="utf-8")


def capability_block(adapter: dict) -> str:
    def readable(value: str) -> str:
        return (value.replace("$HOME", "~")
                .replace("$PROJECT", "project root")
                .replace("$REPO_ROOT", "repository root")
                .replace("$CODEX_HOME", "~/.codex"))

    lines = [f"- `{key}`: {readable(value)}" for key, value in adapter["capabilities"].items()]
    return (
        f"{BEGIN}\n\n## pstack host mapping ({adapter['display_name']})\n\n"
        + "\n".join(lines)
        + f"\n\nGeneral contract: `{root() / 'shim/CAPABILITIES.md'}`\n{END}"
    )


def update_instruction(path: Path, adapter: dict, remove: bool = False) -> bool:
    old = path.read_text(encoding="utf-8") if path.exists() else ""
    start, finish = old.find(BEGIN), old.find(END)
    if start >= 0 and finish >= start:
        finish += len(END)
        new = old[:start].rstrip() + (old[finish:] if remove else "\n\n" + capability_block(adapter) + old[finish:])
        new = new.strip("\n")
    elif remove:
        return False
    else:
        new = (old.rstrip() + "\n\n" if old.strip() else "") + capability_block(adapter)
    if not new and remove:
        if path.exists():
            path.unlink()
        return True
    new += "\n"
    if new == old:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(new, encoding="utf-8")
    return True


def yaml_quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def pointer(adapter: dict, source: Path, staged: Path) -> tuple[Path, str]:
    meta = frontmatter((source / "SKILL.md").read_text(encoding="utf-8"))
    description = meta.get("description", f"Run the {source.name} pstack skill.")
    canonical = staged / source.name / "SKILL.md"
    command = adapter["command"]
    filename = source.name + command["extension"]
    if command["format"] == "toml":
        body = f"description = {json.dumps(description)}\nprompt = {json.dumps(f'Read and follow the canonical pstack skill at {canonical}.')}\n"
    else:
        body = f"---\ndescription: {yaml_quote(description)}\n---\n\nRead and follow the canonical pstack skill at `{canonical}`.\n"
    return Path(filename), body


def load_state(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"artifacts": [], "dirs": []}


def write_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def make_dir(path: Path, created: list[Path]) -> None:
    missing = []
    current = path
    while not current.exists() and current != current.parent:
        missing.append(current)
        current = current.parent
    path.mkdir(parents=True, exist_ok=True)
    created.extend(missing)


def install_one(adapter: dict, host: str, scope: str, project: Path, force: bool, dry: bool) -> list[Path]:
    state_file = state_path(host, scope, project)
    old = load_state(state_file)
    owned = {Path(p) for p in old["artifacts"]}
    artifacts: list[Path] = []
    dirs: list[Path] = []
    staged = staging_root(host)
    skill_root = expand(adapter["skills"].get(scope), project)
    command_root = expand(adapter["command"].get(scope), project)
    instruction = expand(adapter["instruction"].get(scope), project)
    if not skill_root and not command_root:
        raise ValueError(f"{host} has no install target for {scope} scope")
    if not dry:
        if skill_root:
            make_dir(skill_root, dirs)
        if command_root:
            make_dir(command_root, dirs)
        if instruction:
            make_dir(instruction.parent, dirs)
    if skill_root:
        for source in skills():
            destination = skill_root / source.name
            if destination.exists() and destination not in owned and not force:
                print(f"skip unowned existing {destination} (use --force to replace)")
                continue
            artifacts.append(destination)
            if not dry:
                if destination.exists():
                    shutil.rmtree(destination)
                shutil.copytree(source, destination)
                for file in destination.rglob("*"):
                    if file.is_file():
                        file.write_text(rewrite(file.read_text(encoding="utf-8"), adapter, skill_root), encoding="utf-8")
                add_skill_notice(destination, adapter, source)
    if command_root:
        for source in skills():
            relative, body = pointer(adapter, source, staged)
            destination = command_root / relative
            artifacts.append(destination)
            if not dry:
                destination.write_text(body, encoding="utf-8")
        if not dry:
            make_dir(staged, dirs)
            for source in skills():
                destination = staged / source.name
                if destination.exists():
                    shutil.rmtree(destination)
                shutil.copytree(source, destination)
                for file in destination.rglob("*"):
                    if file.is_file():
                        file.write_text(rewrite(file.read_text(encoding="utf-8"), adapter, staged), encoding="utf-8")
                add_skill_notice(destination, adapter, source)
    if instruction:
        artifacts.append(instruction)
        if not dry:
            update_instruction(instruction, adapter)
    if not dry:
        make_dir(state_file.parent, dirs)
        write_state(state_file, {
            "artifacts": [str(p) for p in dict.fromkeys(artifacts)],
            "dirs": [str(p) for p in dict.fromkeys(old.get("dirs", []) + [str(p) for p in dirs])],
        })
    return artifacts


def uninstall_one(adapter: dict, host: str, scope: str, project: Path, dry: bool) -> list[Path]:
    state_file = state_path(host, scope, project)
    state = load_state(state_file)
    removed = []
    for value in state["artifacts"]:
        path = Path(value)
        if path == expand(adapter["instruction"].get(scope), project):
            if path.exists() and not dry:
                update_instruction(path, adapter, remove=True)
            removed.append(path)
        elif path.exists() and (path.is_file() or path.is_dir()):
            if not dry:
                path.unlink() if path.is_file() else shutil.rmtree(path)
            removed.append(path)
    if not dry and state_file.exists():
        state_file.unlink()
    keep_staging = any((state_root() / host).glob("*.json"))
    if not dry:
        if not keep_staging and staging_root(host).exists():
            shutil.rmtree(staging_root(host))
        for value in sorted(state["dirs"], key=lambda item: len(Path(item).parts), reverse=True):
            path = Path(value)
            if path.exists() and path.is_dir():
                if path == staging_root(host):
                    if not keep_staging:
                        shutil.rmtree(path)
                elif not any(path.iterdir()):
                    path.rmdir()
    return removed


def detected(adapters: dict[str, dict], scope: str, project: Path) -> list[str]:
    return [
        name for name, adapter in adapters.items()
        if any(expand(p, project).exists() for p in adapter.get("probes", {}).get(scope, []))
    ]


def doctor(adapters: dict[str, dict], scope: str, project: Path, host_filter: str) -> int:
    hosts = [host_filter] if host_filter != "auto" else list(adapters)
    bad = False
    for name in hosts:
        adapter = adapters[name]
        found = name in detected(adapters, scope, project)
        targets = [expand(spec.get(scope), project) for spec in (adapter["skills"], adapter["command"], adapter["instruction"]) if spec.get(scope)]
        state = load_state(state_path(name, scope, project))
        installed = bool(state["artifacts"])
        missing = [p for p in state["artifacts"] + state["dirs"] if not Path(p).exists()]
        unavailable = [k for k, v in adapter["capabilities"].items() if "unavailable" in v]
        print(f"{name}: detected={found} installed={installed}")
        print("  targets: " + ", ".join(str(p) for p in targets))
        print("  missing artifacts: " + (", ".join(missing) if missing else "none"))
        print("  unavailable: " + (", ".join(unavailable) if unavailable else "none"))
        if host_filter != "auto" and missing:
            bad = True
    return 1 if bad else 0


def main(argv: list[str]) -> int:
    adapters = load_adapters()
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("install", "uninstall", "list-hosts", "doctor"))
    parser.add_argument("--host", default="auto")
    parser.add_argument("--scope", choices=("user", "project"), default="user")
    parser.add_argument("--project-dir", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    project = args.project_dir.resolve() if args.project_dir else Path.cwd()
    if args.command == "list-hosts":
        print("\n".join(adapters))
        return 0
    if args.host != "auto" and args.host not in adapters:
        print(f"unknown host {args.host}; choose from {', '.join(adapters)}", file=sys.stderr)
        return 2
    if args.command == "doctor":
        return doctor(adapters, args.scope, project, args.host)
    hosts = detected(adapters, args.scope, project) if args.host == "auto" else [args.host]
    if not hosts:
        probes = sorted({p for a in adapters.values() for p in a.get("probes", {}).get(args.scope, [])})
        print("no hosts detected; probed: " + ", ".join(probes), file=sys.stderr)
        return 2
    for host in hosts:
        adapter = adapters[host]
        paths = (
            install_one(adapter, host, args.scope, project, args.force, args.dry_run)
            if args.command == "install"
            else uninstall_one(adapter, host, args.scope, project, args.dry_run)
        )
        print(f"{host}: {'would update' if args.dry_run else args.command} {len(paths)} artifacts")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
