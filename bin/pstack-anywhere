#!/usr/bin/env python3
"""Install the pstack skills into several coding-agent hosts."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from pathlib import Path

BEGIN = "<!-- BEGIN pstack-anywhere -->"
END = "<!-- END pstack-anywhere -->"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def load_adapters() -> dict[str, dict]:
    result = {}
    for path in sorted((repo_root() / "adapters").glob("*.json")):
        with path.open(encoding="utf-8") as stream:
            data = json.load(stream)
        result[data["name"]] = data
    return result


def home() -> Path:
    return Path(os.environ.get("HOME", str(Path.home()))).expanduser()


def expand(value: str, project: Path | None = None) -> Path:
    value = value.replace("$HOME", str(home()))
    value = value.replace("$PROJECT", str(project or Path.cwd()))
    return Path(value).expanduser()


def target_path(spec: dict, scope: str, project: Path | None) -> Path | None:
    value = spec.get(scope)
    return expand(value, project) if value else None


def frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end < 0:
        return {}
    result = {}
    for line in text[3:end].splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            result[key.strip()] = value.strip().strip("\"'")
    return result


def rewrite(text: str, adapter: dict) -> str:
    for old, new in adapter.get("rewrites", {}).items():
        text = text.replace(old, new)
    return text


def skills() -> list[Path]:
    return sorted(p.parent for p in (repo_root() / "skills").glob("*/SKILL.md"))


def marker_block(adapter: dict) -> str:
    body = Path(repo_root() / "shim" / "CAPABILITIES.md").read_text(encoding="utf-8")
    title = adapter["display_name"]
    return f"{BEGIN}\n\n## pstack portability contract ({title})\n\n{body}\n{END}"


def update_instruction(path: Path, adapter: dict, remove: bool = False) -> bool:
    old = path.read_text(encoding="utf-8") if path.exists() else ""
    start = old.find(BEGIN)
    finish = old.find(END, start + len(BEGIN)) if start >= 0 else -1
    if start >= 0 and finish >= 0:
        finish += len(END)
        if remove:
            new = old[:start].rstrip() + old[finish:]
            new = new.strip("\n")
        else:
            block = marker_block(adapter)
            new = (old[:start].rstrip() + "\n\n" + block + old[finish:]).strip("\n") + "\n"
    elif remove:
        return False
    else:
        block = marker_block(adapter)
        new = (old.rstrip() + "\n\n" + block if old.strip() else block) + "\n"
    if new == old:
        return False
    if new:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(new, encoding="utf-8")
    elif path.exists():
        path.unlink()
    return True


def pointer(adapter: dict, skill: Path) -> tuple[Path, str]:
    meta = frontmatter((skill / "SKILL.md").read_text(encoding="utf-8"))
    description = meta.get("description", f"Run the {skill.name} pstack skill.")
    canonical = str(skill / "SKILL.md")
    command = adapter["command"]
    filename = skill.name + command["extension"]
    path = Path(filename)
    mode = command["format"]
    if mode == "toml":
        body = f'description = {json.dumps(description)}\nprompt = {json.dumps(f"Read and follow the canonical pstack skill at {canonical}.")}\n'
    elif mode == "copilot":
        body = f"---\ndescription: {description}\n---\n\nRead and follow the canonical pstack skill at `{canonical}`.\n"
    else:
        body = f"---\ndescription: {description}\n---\n\nRead and follow the canonical pstack skill at `{canonical}`.\n"
    return path, body


def manifest_path(root: Path) -> Path:
    return root / ".pstack-anywhere-manifest.json"


def install_one(adapter: dict, scope: str, project: Path | None, force: bool, dry: bool) -> list[Path]:
    made: list[Path] = []
    skill_root = target_path(adapter["skills"], scope, project)
    command_root = target_path(adapter["command"], scope, project)
    instruction = target_path(adapter["instruction"], scope, project)
    if skill_root is None and command_root is None:
        raise ValueError(f"{adapter['name']} has no install target for {scope} scope")
    if skill_root:
        for source in skills():
            destination = skill_root / source.name
            if destination.exists() and not force:
                print(f"skip existing {destination} (use --force to replace)")
                continue
            if not dry:
                destination.parent.mkdir(parents=True, exist_ok=True)
                if destination.exists():
                    shutil.rmtree(destination)
                shutil.copytree(source, destination)
                for file in destination.rglob("*"):
                    if file.is_file():
                        file.write_text(rewrite(file.read_text(encoding="utf-8"), adapter), encoding="utf-8")
            made.append(destination)
    if command_root:
        for source in skills():
            relative, body = pointer(adapter, source)
            destination = command_root / relative
            if not dry:
                destination.parent.mkdir(parents=True, exist_ok=True)
                destination.write_text(body, encoding="utf-8")
            made.append(destination)
    if instruction:
        if not dry:
            update_instruction(instruction, adapter)
        made.append(instruction)
    if not dry:
        root = skill_root or command_root or instruction.parent
        manifest_path(root).parent.mkdir(parents=True, exist_ok=True)
        existing = []
        if manifest_path(root).exists():
            try:
                existing = json.loads(manifest_path(root).read_text(encoding="utf-8"))
            except (OSError, ValueError):
                existing = []
        merged = list(dict.fromkeys(existing + [str(p) for p in made]))
        manifest_path(root).write_text(json.dumps(merged, indent=2) + "\n", encoding="utf-8")
    return made


def uninstall_one(adapter: dict, scope: str, project: Path | None, dry: bool) -> list[Path]:
    targets = [target_path(adapter[key], scope, project) for key in ("skills", "command")]
    instruction = target_path(adapter["instruction"], scope, project)
    removed = []
    for root in targets:
        if not root:
            continue
        manifest = manifest_path(root)
        if manifest.exists():
            try:
                paths = [Path(p) for p in json.loads(manifest.read_text(encoding="utf-8"))]
            except (OSError, ValueError):
                paths = []
            for path in paths:
                if path == instruction:
                    continue
                if path.is_dir():
                    if not dry:
                        shutil.rmtree(path)
                    removed.append(path)
                elif path.exists():
                    if not dry:
                        path.unlink()
                    removed.append(path)
            if not dry:
                manifest.unlink()
            if not dry and root.exists() and not any(root.iterdir()):
                root.rmdir()
            if not dry:
                parent = root.parent
                while parent != home() and parent != project and parent.exists() and not any(parent.iterdir()):
                    parent.rmdir()
                    parent = parent.parent
    if instruction and instruction.exists():
        if not dry:
            update_instruction(instruction, adapter, remove=True)
        removed.append(instruction)
        if not dry:
            parent = instruction.parent
            while parent != parent.parent and parent != project and not any(parent.iterdir()):
                parent.rmdir()
                parent = parent.parent
    return removed


def detected(adapters: dict[str, dict], scope: str, project: Path | None) -> list[str]:
    found = []
    for name, adapter in adapters.items():
        probes = adapter.get("probes", {}).get(scope, [])
        if any(target_path({"path": p}, "path", project).exists() for p in probes):
            found.append(name)
    return found


def doctor(adapters: dict[str, dict], scope: str, project: Path | None) -> int:
    for name, adapter in adapters.items():
        caps = adapter["capabilities"]
        print(f"{name}:")
        for key, value in caps.items():
            print(f"  {key}: {value}")
        if not caps.get("transcript_history", "").startswith("available"):
            print("  doctor: history-dependent skills unavailable")
    return 0


def main(argv: list[str]) -> int:
    adapters = load_adapters()
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("install", "uninstall", "list-hosts", "doctor"))
    parser.add_argument("--host", default="auto")
    parser.add_argument("--scope", choices=("user", "project"), default="user")
    parser.add_argument("--project-dir", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    project = args.project_dir.resolve() if args.project_dir else Path.cwd()
    if args.command == "list-hosts":
        for name in adapters:
            print(name)
        return 0
    if args.command == "doctor":
        return doctor(adapters, args.scope, project)
    if args.host == "auto":
        hosts = detected(adapters, args.scope, project)
        if not hosts:
            probes = sorted({p for a in adapters.values() for p in a.get("probes", {}).get(args.scope, [])})
            print("no hosts detected; probed: " + ", ".join(probes), file=sys.stderr)
            return 2
        print("detected hosts: " + ", ".join(hosts))
    else:
        if args.host not in adapters:
            print(f"unknown host {args.host}; choose from {', '.join(adapters)}", file=sys.stderr)
            return 2
        hosts = [args.host]
    for name in hosts:
        adapter = adapters[name]
        paths = (install_one if args.command == "install" else uninstall_one)(
            adapter, args.scope, project, args.force, args.dry_run
        ) if args.command == "install" else uninstall_one(adapter, args.scope, project, args.dry_run)
        action = "would update" if args.dry_run else ("installed" if args.command == "install" else "removed")
        print(f"{name}: {action} {len(paths)} artifacts")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
